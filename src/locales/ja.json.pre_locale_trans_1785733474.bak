  "category_cards_characters_0_tier": "S",
  "category_cards_characters_0_badge": "レジェンダリー",
  "category_cards_characters_0_subtitle": "ヴァンガードDPS — 最大瞬間火力を誇るノックダウンスペシャリスト",
