  "category_cards_story_1_f0_label": "必要条件",
  "category_cards_story_1_f0_value": "クーの絆レベル最大",
  "category_cards_story_1_f1_label": "報酬",
  "category_cards_story_1_f1_value": "感情的な決着",
  "category_cards_story_1_f2_label": "正史",
  "category_cards_story_1_f2_value": "エピローグ",
  "category_cards_story_2_name": "ノーマルエンディングA",
  "category_cards_story_2_tier": "A",
  "category_cards_story_2_badge": "standard",
  "category_cards_story_2_subtitle": "犠牲エンディング — エマは自己と世界の間で選択を迫られる",
  "category_cards_story_2_f0_label": "必要条件",
  "category_cards_story_2_f0_value": "最低1ループ",
  "category_cards_story_2_f1_label": "報酬",
  "category_cards_story_2_f1_value": "ほろ苦い結末",
