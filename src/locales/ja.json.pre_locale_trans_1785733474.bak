  "category_cards_characters_1_subtitle": "ガーディアンタンク — 凍結+持続回復でチームの生存力を向上",
  "category_cards_characters_1_f0_label": "状態異常",
  "category_cards_characters_1_f0_value": "凍結",
  "category_cards_characters_1_f1_label": "最適ビルド",
